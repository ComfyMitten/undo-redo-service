; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UndoRedoService"
run/main_scene="uid://gtqsjvrryjg0"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="uid://degiwqhx1m53r"

[autoload]

UndoRedoService="*res://addons/undo_redo_service/undo_redo_service.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/directory_rules={
"res://addons": 0,
"res://addons/undo_redo_service": 1
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="UndoRedoService"

[editor_plugins]

enabled=PackedStringArray("res://addons/undo_redo_service/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
